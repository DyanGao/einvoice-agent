# Copy to .env and fill in. .env is gitignored.
# Nothing is required for Stage 1 (structured path uses no external services).

# KoSIT validator sidecar (docker compose up -d validator)
VALIDATOR_URL=http://127.0.0.1:8081

# Postgres (docker compose up -d postgres). "einvoice" is the local development
# default: set your own before running this anywhere else. The compose services
# build their database URL from POSTGRES_PASSWORD; when running from source,
# put the same password into DATABASE_URL. It applies when the database is
# first created: changing it later needs ALTER ROLE or a new database volume.
POSTGRES_PASSWORD=einvoice
DATABASE_URL=postgresql+psycopg://einvoice:einvoice@127.0.0.1:5433/einvoice

# Vision-model extraction for PDFs and scans. Only needed to call the model
# (recording eval answers, processing real documents); tests and replayed evals
# run without it. The SDK also picks up an `ant auth login` profile.
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max; leave empty for the model's default
EXTRACTOR_EFFORT=

# Queue (docker compose up -d redis)
REDIS_URL=redis://127.0.0.1:6380/0
# Which extractor reads PDFs and scans: llm | baseline | none
EXTRACTOR=llm
# PDFs with more pages are not read; a person looks at them instead
MAX_PAGES=10
# Where approved review cases are written. Holds real invoice data: keep it out of git.
FEEDBACK_DIR=data/private/feedback
# Origin of the review UI allowed to call the API
UI_ORIGIN=http://localhost:3000

# Read API of the ERP for supplier, payment account and order checks.
# Leave empty to run without an ERP: those checks are then skipped and each
# invoice carries a note saying so. The mock ERP (make seed, make erp):
# ERP_URL=http://127.0.0.1:8100
ERP_URL=
# How often `make watch` asks the ERP for new bank transfers, in seconds.
BANK_WATCH_SECONDS=300
# How often `make deliver` books approved and auto-decided invoices in the ERP.
DELIVERY_SECONDS=10
# How invoices are booked in the ERP: api (default) or form, through the ERP's
# HTML screens with a browser, for an ERP without a booking API. The browser
# reaches only BROWSER_ALLOWED_HOSTS, comma-separated host:port entries (a bare
# host allows only port 80/443; default: the host and port of ERP_UI_URL), and
# logs every action, with screenshots of failures, in BROWSER_LOG_DIR.
ERP_CHANNEL=api
ERP_UI_URL=
BROWSER_ALLOWED_HOSTS=
BROWSER_LOG_DIR=data/browser
# Folder for the DATEV-style CSV booking lists (one per month); empty = no export.
# EXPORT_DIR=data/export
EXPORT_DIR=
# Receiver of signed bookings (https, or http to localhost) and the secret it
# shares with us, at least 32 characters (e.g. `openssl rand -hex 32`).
# Both empty = no webhook.
WEBHOOK_URL=
WEBHOOK_SECRET=
# The settings above are the default tenant's, as long as it has none of its own.
# Further companies get theirs with the CLI, e.g.
#   einvoice tenant-add acme --name "Acme GmbH"
#   einvoice tenant-set acme erp_url=https://erp.acme.example export_dir=data/export/acme
# A tenant's webhook secret stays here, under a name of its own starting with TENANT_:
#   einvoice tenant-set acme webhook_url=https://... webhook_secret_env=TENANT_ACME_WEBHOOK_SECRET
# TENANT_ACME_WEBHOOK_SECRET=

# Sign-in (v1.0). "on" (the application's default): every request needs a signed-in
# user or an API token — add the first admin with
#   uv run einvoice user-add admin@example.com --name Admin --role admin --password
# "off": no sign-in, as before v1.0; only requests to localhost are answered, and
# reviewers type their name into the UI. Local setups and the demo use "off".
# With "on", the UI and the API must be on the same site (e.g. both on localhost,
# or ui.example.com and api.example.com): the session cookie does not cross sites.
AUTH=off
# Behind a proxy that ends HTTPS and talks plain HTTP to the API: "true" makes the
# sign-in cookies Secure and sends HSTS. "auto" does so only for HTTPS requests.
# COOKIE_SECURE=auto
# Sign-in through an identity provider (Entra ID, Google, Keycloak, ...). Register
# OIDC_REDIRECT_URI (the API's /auth/oidc/callback) with the provider. People get
# in only if an admin added them first: einvoice user-add EMAIL --name NAME --role ROLE
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://einvoice.example.com/auth/oidc/callback
# Entra ID sends no email_verified: set false only for a directory whose emails you control.
# OIDC_REQUIRE_VERIFIED_EMAIL=true
